{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "pos": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm install && npm run build",
      "outputDirectory": "dist",
      "installCommand": "npm install"
    },
    "hrms": {
      "root": "frontend-hrms",
      "framework": "vite",
      "buildCommand": "npm install && npm run build",
      "outputDirectory": "dist",
      "installCommand": "npm install"
    }
  },
  "routes": [
    {
      "src": "/hrms/(.*)",
      "dest": "hrms"
    },
    {
      "src": "/(.*)",
      "dest": "pos"
    }
  ]
}