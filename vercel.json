{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "pos": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "installCommand": "npm install --include=dev"
    },
    "hrms": {
      "root": "frontend-hrms",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "installCommand": "npm install --include=dev"
    }
  },
  "routes": [
    { "src": "/hrms/(.*)", "dest": "/hrms/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}