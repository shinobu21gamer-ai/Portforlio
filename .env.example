# ===========================================
# MiniMart POS/HRMS - Environment Variables Template
# ===========================================
# Copy to .env and fill in your values

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
JWT_REFRESH_SECRET=

# Database
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# App Config
NODE_ENV=production
PORT=5000
APP_NAME=MiniMart POS
APP_CURRENCY=PHP
APP_TAX_RATE=12

# Frontend URLs (for CORS)
VITE_API_URL=https://your-backend-domain.com/api/v1
VITE_HRMS_URL=https://your-hrms-frontend.vercel.app

# Email (optional - for password reset, receipts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# PayMongo (optional - for online payments)
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# REQUIRED for online payments in production. Without it every PayMongo webhook
# is rejected with HTTP 400 (verification fails closed), so sales paid via
# checkout stay "pending" until someone visits the success page.
# Set this in the PayMongo dashboard under Webhooks.
PAYMONGO_WEBHOOK_SECRET=

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Logging
LOG_LEVEL=info