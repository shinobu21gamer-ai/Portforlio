# ===========================================
# MiniMart POS/HRMS - Environment Variables Template
# ===========================================
# Copy to .env and fill in your values

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
JWT_REFRESH_SECRET=

# Database
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# App Config
NODE_ENV=production
PORT=5000
APP_NAME=MiniMart POS
APP_CURRENCY=PHP
APP_TAX_RATE=12

# Frontend URLs (for CORS)
VITE_API_URL=https://your-backend-domain.com/api/v1
VITE_HRMS_URL=https://your-hrms-frontend.vercel.app

# Email (optional - for password reset, receipts)
# Without these, sendEmail() logs to the console instead of sending and every
# caller ignores the result, so emails fail silently. Check the deploy logs for
# "[MAILER] SMTP not configured" to confirm whether this is set.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmail requires an App Password, NOT your normal account password:
#   Google Account -> Security -> 2-Step Verification -> App passwords
# A normal password fails with "534-5.7.9 Invalid login".
SMTP_PASS=
# NOTE: the variable read by src/config is EMAIL_FROM, not MAIL_FROM.
# If left blank the sender falls back to SMTP_USER.
EMAIL_FROM=

# PayMongo (optional - for online payments)
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# REQUIRED for online payments in production. Without it every PayMongo webhook
# is rejected with HTTP 400 (verification fails closed), so sales paid via
# checkout stay "pending" until someone visits the success page.
# Set this in the PayMongo dashboard under Webhooks.
PAYMONGO_WEBHOOK_SECRET=

# Public base URL of the POS frontend. Used for PayMongo's success/cancel
# redirects after checkout. Leave blank to use the origin the request arrived
# on (correct for most deployments, including Render behind its proxy).
# Set it explicitly only if the POS is served from a different public host
# than the API, e.g. POS_FRONTEND_URL=https://pos.example.com
POS_FRONTEND_URL=

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Logging
LOG_LEVEL=info