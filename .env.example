# ─── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ─── Database ────────────────────────────────────────────
# SQLite (default for development)
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# MySQL (for production — set DB_DIALECT=mysql)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=minimart_pos
# DB_USER=root
# DB_PASSWORD=your_db_password_here

# ─── JWT ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_random_64_char_hex_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_to_another_random_64_char_hex_string
JWT_REFRESH_EXPIRES_IN=30d

# ─── Bcrypt ──────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=10

# ─── File Upload ─────────────────────────────────────────
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/products

# ─── Email (SMTP) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=your_email@gmail.com

# ─── App ─────────────────────────────────────────────────
APP_NAME=MiniMart POS
DEFAULT_CURRENCY=PHP
TAX_RATE=0.12
LOW_STOCK_THRESHOLD=10
EXPIRY_WARNING_DAYS=30
FRONTEND_URL=http://localhost:3001
POS_FRONTEND_URL=http://localhost:5173

# ─── Paymongo ────────────────────────────────────────────
PAYMONGO_SECRET_KEY=sk_test_your_test_secret_key
PAYMONGO_PUBLIC_KEY=pk_test_your_test_public_key
PAYMONGO_WEBHOOK_SECRET=whsec_your_webhook_secret_here
