# ===========================================
# MiniMart POS/HRMS - Environment Variables Template
# ===========================================
# Copy to .env and fill in your values

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
JWT_REFRESH_SECRET=

# Database
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# App Config
NODE_ENV=production
PORT=5000
APP_NAME=MiniMart POS
APP_CURRENCY=PHP
APP_TAX_RATE=12
# Business timezone for dashboard/report day bounds (IANA). Default Asia/Manila.
# APP_TIMEZONE=Asia/Manila

# Production first-run admin (only used when the users table is empty).
# Password must be 12+ characters. Unset password → a one-time generated
# 32-hex secret is printed to the deploy logs once.
# INITIAL_ADMIN_EMAIL=admin@minimart.com
# INITIAL_ADMIN_PASSWORD=

# Frontend URLs (for CORS)
VITE_API_URL=https://your-backend-domain.com/api/v1
VITE_HRMS_URL=https://your-hrms-frontend.vercel.app

# CORS origins. UNSET = same-origin only (the standard single-host deploy:
# API + POS + HRMS all served from one domain). Set a comma-separated list to
# allow extra origins (e.g. separately deployed frontends), or * for an
# API-only, cookie-less consumer (credentials are disabled in that mode).
# CORS_ORIGIN=https://pos.example.com,https://hrms.example.com

# Public self-registration (POST /api/v1/auth/register).
# Default: OFF in production, ON in development. An admin can also toggle it
# at runtime from Settings → Security. Setting it here overrides the toggle.
# ALLOW_PUBLIC_REGISTRATION=false

# Attendance geofencing is configured per branch in the Branches screen
# (latitude/longitude + radius + enforce toggle), not via env vars. It is OFF
# by default: a branch only checks clock-in location once an admin sets a
# radius and turns enforcement on.

# Public origin of the site, used for links inside outbound emails
# (password reset, payslips, contract notices, applicant status).
# Normally NOT needed: it is derived from the incoming request. Set it only if
# the emails should point somewhere other than where the request arrived.
# FRONTEND_URL=https://your-site.example.com

# Email (optional - for password reset, receipts)
# Without these, sendEmail() logs to the console instead of sending and every
# caller ignores the result, so emails fail silently. Check the deploy logs for
# "[MAILER] SMTP not configured" to confirm whether this is set.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmail requires an App Password, NOT your normal account password:
#   Google Account -> Security -> 2-Step Verification -> App passwords
# A normal password fails with "534-5.7.9 Invalid login".
SMTP_PASS=
# NOTE: the variable read by src/config is EMAIL_FROM, not MAIL_FROM.
# If left blank the sender falls back to SMTP_USER.
EMAIL_FROM=

# Production boot guard: in NODE_ENV=production the app REFUSES to boot when
# SMTP_HOST is unset, unless you explicitly opt out of outbound email with
# EMAIL_DISABLED=true (emails are then dropped with a log line). In
# development this is only a warning. Set one or the other when running in
# production — a silent mailer used to drop every password reset/payslip.
# EMAIL_DISABLED=true

# PayMongo (optional - for online payments)
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# REQUIRED for online payments in production. Without it every PayMongo webhook
# is rejected with HTTP 400 (verification fails closed), so sales paid via
# checkout stay "pending" until someone visits the success page.
# Set this in the PayMongo dashboard under Webhooks.
PAYMONGO_WEBHOOK_SECRET=

# Public base URL of the POS frontend. Used for PayMongo's success/cancel
# redirects after checkout. Leave blank to use the origin the request arrived
# on (correct for most deployments, including Render behind its proxy).
# Set it explicitly only if the POS is served from a different public host
# than the API, e.g. POS_FRONTEND_URL=https://pos.example.com
POS_FRONTEND_URL=

# File Uploads
# Root for product images, resumes and HR documents. In production point this
# at the persistent volume (e.g. /data/uploads on Render with a disk attached,
# or /data/uploads in the Docker image). If the directory cannot be created or
# written, the server logs a [STORAGE] warning and falls back to a writable
# location inside the app instead of crashing — but that fallback is wiped on
# the next deploy/restart.
UPLOAD_DIR=./uploads
# Optional: exact directory for product images (defaults to <UPLOAD_DIR>/products)
# UPLOAD_PATH=
MAX_FILE_SIZE=5242880

# Logging
LOG_LEVEL=info