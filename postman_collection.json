        { "name": "Mark Read", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"ids\": [1, 2, 3]}" }, "url": { "raw": "{{base_url}}/notifications/mark-read", "host": ["{{base_url}}"], "path": ["notifications", "mark-read"] } } }
