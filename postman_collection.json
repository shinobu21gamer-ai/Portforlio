    {
      "name": "Inventory",
      "item": [
        { "name": "Stock In", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"productId\": 1, \"quantity\": 50, \"notes\": \"Restock\"}" }, "url": { "raw": "{{base_url}}/inventory/stock-in", "host": ["{{base_url}}"], "path": ["inventory", "stock-in"] } } },
        { "name": "Stock Out", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"productId\": 1, \"quantity\": 5, \"notes\": \"Damaged goods\"}" }, "url": { "raw": "{{base_url}}/inventory/stock-out", "host": ["{{base_url}}"], "path": ["inventory", "stock-out"] } } },
        { "name": "Adjust Stock", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"productId\": 1, \"newQuantity\": 80, \"reason\": \"Inventory count correction\", \"type\": \"adjustment\"}" }, "url": { "raw": "{{base_url}}/inventory/adjust", "host": ["{{base_url}}"], "path": ["inventory", "adjust"] } } },
        { "name": "Stock Movements", "request": { "method": "GET", "url": { "raw": "{{base_url}}/inventory/movements?page=1&limit=20", "host": ["{{base_url}}"], "path": ["inventory", "movements"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }] } } },
        { "name": "Inventory Logs", "request": { "method": "GET", "url": { "raw": "{{base_url}}/inventory/logs?page=1&limit=20", "host": ["{{base_url}}"], "path": ["inventory", "logs"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }] } } },
