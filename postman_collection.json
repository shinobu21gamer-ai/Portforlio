        { "name": "Check Expiring", "request": { "method": "GET", "url": { "raw": "{{base_url}}/inventory/check-expiring?days=30", "host": ["{{base_url}}"], "path": ["inventory", "check-expiring"], "query": [{ "key": "days", "value": "30" }] } } }
